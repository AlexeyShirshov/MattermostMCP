{
  "version": "0.2.0",
  "inputs": [
    {
      "id": "hostOs",
      "type": "pickString",
      "description": "Host OS build folder (matches bin/<os> from Directory.Build.props)",
      "options": [
        "linux",
        "windows",
        "osx"
      ],
      "default": "linux"
    }
  ],
  "configurations": [
    {
      "name": "MCP Server (Local)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/McpServer/bin/${input:hostOs}/Debug/net10.0/MattermostMCP.McpServer.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/McpServer",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Local",
        "ASPNETCORE_URLS": "http://127.0.0.1:8085"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    },
    {
      "name": "MCP Server (Development)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/McpServer/bin/${input:hostOs}/Debug/net10.0/MattermostMCP.McpServer.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/McpServer",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://127.0.0.1:8085"
      }
    }
  ]
}
